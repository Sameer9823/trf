# API server
API_HOST=0.0.0.0
API_PORT=4000
# Allowed browser origins are not needed for the desktop app (it calls the API from Electron's main process).
# One log file per day is written here, and 30 days are kept.
LOG_DIR=./logs
# info normally; debug only while investigating a problem.
LOG_LEVEL=info
# Where `npm run backup` writes its dumps. Kept for 30 days.
BACKUP_DIR=./backups

# PostgreSQL (company server). Never commit the real .env.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-secure-password
DATABASE_POOL_MAX=10

# Authentication. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Rotating this invalidates every issued token.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Brute-force protection: lock the account after this many consecutive failures.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Used only by `npm run seed:admin` to create the first administrator.
# Remove the password from this file after the first administrator exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-first-password
ADMIN_EMPLOYEE_CODE=ADMIN-001
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@company.local

# Where generated TRF PDF documents are stored on the server.
# Use an absolute path so the backup and the service account resolve the same folder.
DOCUMENT_DIR=./storage/documents

# Public URL of the desktop app's host page, used to build password-reset links.
# If unset, reset links fall back to http://localhost:5173 (only correct on a dev PC).
FRONTEND_URL=http://localhost:5173

# Outgoing email (Zoho SMTP by default) for password-reset and password-changed mail.
# EMAIL_USER and EMAIL_PASS are required before any email can be sent.
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=465
# true for implicit TLS (port 465); false for STARTTLS (port 587).
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
# The From address on outgoing mail; defaults to EMAIL_USER when unset.
EMAIL_FROM=

# Allowed CORS origin for the Electron app. Defaults to app://trf-desktop.
CORS_ORIGIN=app://trf-desktop

# Reverse-proxy trust for req.ip (rate limiting). Leave unset when the server is
# exposed directly. true/1, a hop count, or an IP/subnet list (e.g. 'loopback').
TRUST_PROXY=
