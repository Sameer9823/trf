# API server
API_HOST=0.0.0.0
API_PORT=4000
# Allowed browser origins are not needed for the desktop app (it calls the API from Electron's main process).
# One log file per day is written here, and 30 days are kept.
LOG_DIR=./logs
# info normally; debug only while investigating a problem.
LOG_LEVEL=info
# Where `npm run backup` writes its dumps. Kept for 30 days.
BACKUP_DIR=./backups

# PostgreSQL (company server). Never commit the real .env.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=Sameer@9823
DATABASE_POOL_MAX=10

# Authentication. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Rotating this invalidates every issued token.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Brute-force protection: lock the account after this many consecutive failures.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Used only by `npm run seed:admin` to create the first administrator.
# Remove the password from this file after the first administrator exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-first-password
ADMIN_EMPLOYEE_CODE=ADMIN-001
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@company.local
