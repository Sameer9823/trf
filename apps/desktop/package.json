{
  "name": "@trf/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TRF Management System desktop client",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p electron/tsconfig.json && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p electron/tsconfig.json && tsc --noEmit -p tsconfig.json && vite build",
    "package": "npm run build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p tsconfig.json"
  },
  "build": {
    "appId": "com.company.trf",
    "productName": "TRF Management System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/default-config.json",
        "to": "default-config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TRF-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TRF Management System"
    }
  },
  "dependencies": {
    "@trf/shared": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
